# 复制为 .env.production 后部署。公网模式：勿填写你的个人 API Key / GitHub Token
DEPLOY_MODE=public
ALLOW_RUNTIME_CREDENTIALS=true
USE_SERVER_GITHUB_TOKEN=false
USE_SERVER_CLOUD_CREDENTIALS=false
LLM_MODE=cloud_only
USE_MOCK_LLM=false

DEEPSEEK_API_KEY=
CLOUD_API_KEY=
GITHUB_TOKEN=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner

REVIEW_DEPTH_MODE=balanced
CLOUD_TIMEOUT_SEC=300

# Caddy 证书域名（docker compose 可 -e SITE_DOMAIN=你的域名）
SITE_DOMAIN=review.example.com
