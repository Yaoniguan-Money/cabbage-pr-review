# 演示环境变量模板
DEBUG=false
LOG_LEVEL=INFO
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
WORKER_CONCURRENCY=4

# 生产环境请改用密钥管理服务，不要提交真实凭证
ALERT_WEBHOOK_URL=
STORAGE_BUCKET=demo-security-artifacts
STORAGE_REGION=ap-east-1
ENCRYPTION_KEY_ALIAS=demo-master-key

# 会话与安全
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 审计与可观测性
AUDIT_LOG_ENABLED=true
METRICS_PUSH_INTERVAL=60
TELEMETRY_SAMPLE_RATE=0.25

# 缓存与限流
CACHE_DEFAULT_TTL=300
RATE_LIMIT_PER_MINUTE=120

# 国际化
DEFAULT_LOCALE=zh-CN

# 维护模式
MAINTENANCE_MODE=false

# 存储签名 URL
STORAGE_SIGNED_URL_TTL=600

# 异步任务
ASYNC_TASK_QUEUE=security_tasks
ASYNC_TASK_MAX_RETRIES=3

# 合规
COMPLIANCE_MODE=standard
DATA_RETENTION_DAYS=365
PII_MASKING_ENABLED=true
