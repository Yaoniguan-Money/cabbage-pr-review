# 复制为 .env。v2.0 §7.3：Flash/Pro 型号名以 DeepSeek 控制台为准（映射 V4 能力）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner
USE_MOCK_LLM=false

# GitHub Token（PR URL 必填，否则 403 限流）：classic token 勾选 public_repo
GITHUB_TOKEN=ghp_粘贴你的token_不要留空

# pytest 专用：测试会 patch LLM，不消耗额度
# USE_MOCK_LLM 保持 false，测试通过 conftest mock client

# 默认审阅深度：conservative | balanced | aggressive
REVIEW_DEPTH_MODE=balanced
