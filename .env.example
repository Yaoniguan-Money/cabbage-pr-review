# 复制为 .env 以覆盖 .env.demo（docker compose 先加载 demo 再加载本文件）。
# 仅体验规则引擎可省略本文件，直接 docker compose up。
# 公网部署请用 .env.production.example，并设置 DEPLOY_MODE=public（勿写个人 Key）。
DEPLOY_MODE=local
# 评委/公网环境务必 DEPLOY_MODE=public，且勿在下方填写个人 GITHUB_TOKEN / API Key
ALLOW_RUNTIME_CREDENTIALS=true
# 公网或多人访问时设为 false（public 模式会强制忽略服务器 Token）
USE_SERVER_GITHUB_TOKEN=true
USE_SERVER_CLOUD_CREDENTIALS=true
CLOUD_TIMEOUT_SEC=120
# v2.0 §7.3：Flash/Pro 型号名以 DeepSeek 控制台为准（映射 V4 能力）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
USE_MOCK_LLM=false

# GitHub Token（PR URL 必填，否则 403 限流）：classic token 勾选 public_repo
GITHUB_TOKEN=ghp_粘贴你的token_不要留空

# pytest 专用：测试会 patch LLM，不消耗额度
# USE_MOCK_LLM 保持 false，测试通过 conftest mock client

# 默认审阅深度：conservative | balanced | aggressive
REVIEW_DEPTH_MODE=balanced

# v2.2 推理模式（cloud_only | hybrid | local_only | rules_only）
LLM_MODE=cloud_only
CLOUD_API_BASE=
CLOUD_API_KEY=
CLOUD_FLASH_MODEL=
CLOUD_PRO_MODEL=
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_DEFAULT_MODEL=
LOCAL_LLM_TIMEOUT_SEC=180
LOCAL_COMPRESS_ENABLED=true

# v2.4 纯规则模式：可选自定义规则包目录（默认 backend/app/rules/packs/default）
RULES_PACK_PATH=
