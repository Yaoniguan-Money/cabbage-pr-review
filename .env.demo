# 零 Key 克隆仓库时的安全默认：纯规则 + Patch 演示
# 本地全功能：复制 .env.example 或在 .env 中设置 DEPLOY_MODE=local 并填写 Key
LLM_MODE=rules_only
USE_MOCK_LLM=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner

GITHUB_TOKEN=

REVIEW_DEPTH_MODE=balanced
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_COMPRESS_ENABLED=false
